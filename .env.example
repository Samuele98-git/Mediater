# ==============================================================
# Mediater — environment configuration
# Copy this file to `.env` and edit the values before starting.
# ==============================================================

# Runtime mode: "development" or "production"
NODE_ENV=production

# HTTP port to listen on
PORT=3000

# Bind address. Use 0.0.0.0 to accept connections from the network
# (required inside Docker / on a server). Use 127.0.0.1 to restrict
# to localhost in development.
HOST=0.0.0.0

# REQUIRED in production. Long random string used to sign session
# cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# How many days a "remember me" session should last.
SESSION_TTL_DAYS=30

# Set to "true" when serving Mediater behind HTTPS (e.g. via Nginx).
# This makes session cookies "Secure" so they're only sent over TLS.
COOKIE_SECURE=false

# Reverse proxy in front of Mediater (Nginx, Traefik, Caddy, Cloudflare…)?
# Set this to the number of proxy hops, usually 1. Keep 0 when people
# connect to Mediater directly: otherwise anyone can fake their address
# and dodge the limit on wrong PINs. (Left blank, production assumes 1.)
TRUST_PROXY=0

# Public address of this server (used for SSO callbacks), e.g.
# https://media.example.com — can also be set in Admin → Settings.
# PUBLIC_URL=

# Bootstrap admin credentials (only used the first time the DB is
# empty). CHANGE THE PASSWORD before deploying to production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Prisma database URL (SQLite). Relative paths are relative to prisma/.
DATABASE_URL=file:./dev.db

# --------------------------------------------------------------
# Storage
# --------------------------------------------------------------
# Everything written at runtime: torrent downloads, thumbnails cache,
# saved .torrent files. Defaults to ./data
# DATA_DIR=./data
# Where torrent downloads go (defaults to DATA_DIR/downloads). Point it at
# a big disk, e.g. D:/Media/Downloads or /mnt/media/downloads
# DOWNLOAD_DIR=
# Uploaded artwork, videos and subtitles (defaults to ./public/uploads)
# UPLOAD_DIR=

# --------------------------------------------------------------
# Torrents
# --------------------------------------------------------------
# Listening port for BitTorrent (empty/0 = random). Forward it on your
# router (TCP + UDP) for much better speeds. Docker defaults to 6881.
TORRENT_PORT=
# Try to open the port automatically with UPnP / NAT-PMP (true/false)
TORRENT_UPNP=true
# Turn the torrent client off completely
# TORRENTS_ENABLED=false

# --------------------------------------------------------------
# Playback / metadata
# --------------------------------------------------------------
# A free TMDB key (https://www.themoviedb.org/settings/api) fills in
# posters, logos, trailers, cast and episode names. You can also paste
# it in Admin → Settings instead.
# TMDB_API_KEY=
# ffmpeg is found on the PATH automatically; set these to use another copy.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Hardware encoder for live conversion (libx264, h264_nvenc, h264_qsv, h264_amf, h264_videotoolbox)
# FFMPEG_VIDEO_ENCODER=libx264
# How many videos can be converted at the same time
# MAX_TRANSCODES=4
