{
  "name": "mediater",
  "version": "3.0.0",
  "description": "Self-hosted Netflix-style streaming server with profiles, a Netflix-like player and a built-in torrent downloader that streams while downloading",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/migrate.mjs && node server.js",
    "dev": "node scripts/migrate.mjs && nodemon server.js",
    "migrate": "node scripts/migrate.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop mediater",
    "pm2:logs": "pm2 logs mediater",
    "reset-pin": "node scripts/reset-pin.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "fs-chunk-store": "^5.0.1",
    "multer": "^2.0.2",
    "parse-torrent": "^11.0.24",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-openidconnect": "^0.1.2",
    "prisma": "^5.19.0",
    "range-parser": "^1.3.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
