<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('partials/head', { extraCss: 'player' }) %>
    <title><%= parent ? parent.title + ' – ' : '' %><%= media.title %> – <%= APP_NAME %></title>
</head>
<body class="nf-watch">
<div class="nfp" id="nfp">
    <video id="nfpVideo" playsinline webkit-playsinline preload="auto"></video>
    <div class="nfp-subs" id="nfpSubs" aria-live="off"></div>

    <div class="nfp-idle" id="nfpIdle">
        <small><%= t('player.youre_watching') %></small>
        <h1><%= parent ? parent.title : media.title %></h1>
        <% if (parent) { %><h2><%= t('player.season_episode', { s: media.season, e: media.order }) %> “<%= media.title %>”</h2><% } %>
        <div class="meta"><%= media.year %><% if (media.maturity) { %> · <%= media.maturity %><% } %></div>
        <% if (media.description) { %><p><%= media.description %></p><% } %>
        <span class="paused"><%= t('player.paused') %></span>
    </div>

    <div class="nfp-spinner" id="nfpSpinner"><div class="ring"></div><small id="nfpSpinnerText"></small></div>
    <div class="nfp-center" id="nfpCenter">
        <button class="nfp-cbtn" id="nfpCBack" type="button" aria-label="<%= t('player.back_10') %>"><i class="fa-solid fa-rotate-left"></i><span class="num">10</span></button>
        <button class="nfp-cbtn big" id="nfpCPlay" type="button" aria-label="<%= t('player.play') %>"><i class="fa-solid fa-play"></i></button>
        <button class="nfp-cbtn" id="nfpCFwd" type="button" aria-label="<%= t('player.forward_10') %>"><i class="fa-solid fa-rotate-right"></i><span class="num">10</span></button>
    </div>
    <div class="nfp-flash" id="nfpFlash"><i class="fa-solid fa-play"></i></div>
    <div class="nfp-seekflash left" id="nfpSeekBack"><i class="fa-solid fa-rotate-left"></i><span>10</span></div>
    <div class="nfp-seekflash right" id="nfpSeekFwd"><i class="fa-solid fa-rotate-right"></i><span>10</span></div>

    <div class="nfp-top">
        <a class="nfp-back" href="<%= backUrl %>" id="nfpBack" aria-label="<%= t('player.back') %>"><i class="fa-solid fa-arrow-left"></i></a>
        <span class="nfp-chip" id="nfpTorrentChip" hidden><i class="fa-solid fa-arrow-down"></i><span></span></span>
        <% if (preview) { %><span class="nfp-chip"><i class="fa-solid fa-eye"></i><%= t('player.torrent_preview') %></span><% } %>
        <span class="spacer"></span>
        <div class="nfp-top-title"><% if (parent) { %><b><%= parent.title %></b> <%= t('player.ep_short', { e: media.order }) %> <%= media.title %><% } else { %><b><%= media.title %></b><% } %></div>
        <button class="nfp-fs-top" id="nfpFsTop" type="button" aria-label="<%= t('player.fullscreen') %>"><i class="fa-solid fa-expand"></i></button>
    </div>

    <button class="nfp-skip" id="nfpSkip" type="button" hidden><%= t('player.skip_intro') %></button>
    <div class="nfp-postplay" id="nfpPostplay" hidden>
        <button class="ghost" type="button" id="nfpWatchCredits"><%= t('player.watch_credits') %></button>
        <button class="nfp-next-btn" type="button" id="nfpNextBtn"><span class="fillbar"></span><span><i class="fa-solid fa-play"></i> <%= t('player.next_episode') %></span></button>
    </div>

    <div class="nfp-bottom">
        <div class="nfp-timeline">
            <div class="nfp-bar" id="nfpBar" role="slider" aria-label="<%= t('player.seek') %>" tabindex="0">
                <div class="nfp-bar-track">
                    <div class="nfp-bar-buffer" id="nfpBuffer"></div>
                    <div class="nfp-bar-hoverfill" id="nfpHoverFill"></div>
                    <div class="nfp-bar-fill" id="nfpFill"></div>
                    <div class="nfp-markers" id="nfpMarkers"></div>
                </div>
                <div class="nfp-bar-knob" id="nfpKnob"></div>
                <div class="nfp-preview" id="nfpPreview"><div class="nfp-thumb" id="nfpThumb"></div><span id="nfpPreviewTime">0:00</span></div>
            </div>
            <span class="nfp-remaining" id="nfpRemaining">--:--</span>
        </div>
        <div class="nfp-controls">
            <button class="nfp-btn" id="nfpPlay" type="button" aria-label="<%= t('player.play') %>"><i class="fa-solid fa-play"></i></button>
            <button class="nfp-btn" id="nfpBack10" type="button" aria-label="<%= t('player.back_10') %>"><i class="fa-solid fa-rotate-left"></i><span class="num">10</span></button>
            <button class="nfp-btn" id="nfpFwd10" type="button" aria-label="<%= t('player.forward_10') %>"><i class="fa-solid fa-rotate-right"></i><span class="num">10</span></button>
            <div class="nfp-vol" id="nfpVol">
                <button class="nfp-btn" id="nfpMute" type="button" aria-label="<%= t('player.mute') %>"><i class="fa-solid fa-volume-high"></i></button>
                <div class="nfp-vol-pop"><div class="nfp-vol-slider" id="nfpVolSlider"><div class="fill"></div><div class="knob"></div></div></div>
            </div>
            <div class="nfp-title"><% if (parent) { %><b><%= parent.title %></b><span><%= t('player.ep_short', { e: media.order }) %> <%= media.title %></span><% } else { %><b><%= media.title %></b><% } %></div>
            <span class="spacer-m"></span>
            <% if (nextEpisode) { %><button class="nfp-btn" id="nfpNextEp" type="button" aria-label="<%= t('player.next_episode') %>"><i class="fa-solid fa-forward-step"></i><span class="lbl"><%= t('player.next_ep_short') %></span></button><% } %>
            <% if (episodes.length > 1) { %><button class="nfp-btn" id="nfpEpisodesBtn" type="button" aria-label="<%= t('player.episodes') %>"><i class="fa-solid fa-layer-group"></i><span class="lbl"><%= t('player.episodes') %></span></button><% } %>
            <button class="nfp-btn" id="nfpAudioBtn" type="button" aria-label="<%= t('player.audio_subtitles') %>"><i class="fa-regular fa-closed-captioning"></i><span class="lbl"><%= t('player.audio_subtitles') %></span></button>
            <button class="nfp-btn nfp-btn-speed" id="nfpSpeedBtn" type="button" aria-label="<%= t('player.speed') %>"><i class="fa-solid fa-gauge-high"></i><span class="lbl" id="nfpSpeedLbl"><%= t('player.speed_short') %> (1x)</span></button>
            <button class="nfp-btn nfp-btn-lock" id="nfpLock" type="button" aria-label="<%= t('player.lock') %>"><i class="fa-solid fa-lock-open"></i><span class="lbl"><%= t('player.lock') %></span></button>
            <button class="nfp-btn" id="nfpFs" type="button" aria-label="<%= t('player.fullscreen') %>"><i class="fa-solid fa-expand"></i><span class="lbl"><%= t('player.fullscreen') %></span></button>
        </div>
    </div>

    <div class="nfp-panel" id="nfpPanelAudio"><div class="nfp-audiosubs">
        <div><h4><%= t('player.audio') %></h4><ul id="nfpAudioList"></ul></div>
        <div><h4><%= t('player.subtitles') %></h4><ul id="nfpSubList"></ul>
            <div class="nfp-subsize" id="nfpSubSize">
                <button type="button" data-size="0.8"><%= t('player.size_small') %></button><button type="button" data-size="1"><%= t('player.size_medium') %></button><button type="button" data-size="1.3"><%= t('player.size_large') %></button>
            </div>
        </div>
    </div></div>
    <div class="nfp-panel nfp-speed" id="nfpPanelSpeed">
        <h4><%= t('player.playback_speed') %></h4>
        <div class="nfp-speed-track" id="nfpSpeedTrack">
            <% [0.5, 0.75, 1, 1.25, 1.5].forEach(function (s) { %><button type="button" data-speed="<%= s %>"><%= s === 1 ? t('player.speed_normal') : s + 'x' %></button><% }) %>
        </div>
    </div>
    <% if (episodes.length > 1) { %>
    <div class="nfp-panel nfp-episodes" id="nfpPanelEpisodes">
        <div class="season"><%= parent.title %> ·
            <select id="nfpSeasonSel">
                <% [...new Set(episodes.map(function (e) { return e.season; }))].forEach(function (s) { %><option value="<%= s %>"<%= s === media.season ? ' selected' : '' %>><%= t('player.season_n', { n: s }) %></option><% }) %>
            </select>
        </div>
        <div id="nfpEpList"></div>
    </div>
    <% } %>
    <% if (nextEpisode) { %>
    <div class="nfp-nextcard" id="nfpNextCard">
        <h4><%= t('player.next_episode') %></h4>
        <div class="body">
            <% if (nextEpisode.thumbnail) { %><img src="<%= nextEpisode.thumbnail %>" alt=""><% } %>
            <div><b><%= nextEpisode.order %>. <%= nextEpisode.title %></b><p><%= nextEpisode.description %></p></div>
        </div>
    </div>
    <% } %>

    <% if (nextEpisode) { %>
    <div class="nfp-still" id="nfpStill" hidden role="dialog" aria-modal="true" aria-labelledby="nfpStillTitle">
        <% if (media.backdrop) { %><img class="bg" src="<%= media.backdrop %>" alt=""><% } %>
        <div class="box">
            <h2 id="nfpStillTitle"><%= t('player.still_watching', { title: parent ? parent.title : media.title }) %></h2>
            <div class="row">
                <button type="button" class="nf-btn nf-btn-white" id="nfpStillYes"><i class="fa-solid fa-play"></i> <%= t('player.continue_watching') %></button>
                <a class="nf-btn" href="<%= backUrl %>"><%= t('player.back_to_browse') %></a>
            </div>
        </div>
    </div>
    <% } %>

    <div class="nfp-locked" id="nfpLocked" hidden>
        <button type="button" id="nfpUnlock"><i class="fa-solid fa-lock"></i><span id="nfpUnlockText"><%= t('player.screen_locked') %></span><small id="nfpUnlockHint"><%= t('player.tap_to_unlock') %></small></button>
    </div>

    <div class="nfp-error" id="nfpError" hidden>
        <h2 id="nfpErrorTitle"><%= t('player.error_title') %></h2>
        <p id="nfpErrorText"></p>
        <code id="nfpErrorCode"></code>
        <div class="row">
            <button class="nf-btn nf-btn-white" type="button" id="nfpRetry"><i class="fa-solid fa-rotate-right"></i> <%= t('player.try_again') %></button>
            <a class="nf-btn" href="<%= backUrl %>"><%= t('player.back') %></a>
        </div>
    </div>
</div>
<script>
window.__nfp = <%- jsonScript({
    source: source,
    mediaId: media.id,
    title: media.title,
    showTitle: parent ? parent.title : null,
    backdrop: media.backdrop,
    resume: resume,
    markers: markers,
    preview: preview,
    backUrl: backUrl,
    nextEpisode: nextEpisode,
    episodes: episodes,
    current: media.id,
    similar: typeof similar !== 'undefined' ? similar : [],
    isAdmin: !!canAdmin,
    i18n: dict.player || {}
}) %>;
</script>
<script src="/js/player.js?v=<%= assetVersion %>"></script>
</body>
</html>
