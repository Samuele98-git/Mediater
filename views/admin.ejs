<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <%- include('partials/head', { extraCss: 'admin' }) %>
    <title><%= t('nav.manage') %> – <%= APP_NAME %></title>
</head>
<body class="adm">
<% const fmtB = function (n) { n = Number(n) || 0; var u = ['B','KB','MB','GB','TB'], i = 0; while (n >= 1024 && i < 4) { n /= 1024; i++; } return n.toFixed(i > 1 ? 1 : 0) + ' ' + u[i]; }; %>
<aside class="adm-side">
    <a href="/" class="nf-logo"><%= APP_NAME %></a>
    <button type="button" data-tab="library"><i class="fa-solid fa-film"></i> <%= t('admin.library') %></button>
    <button type="button" data-tab="users"><i class="fa-solid fa-users"></i> <%= t('admin.users') %></button>
    <button type="button" data-tab="settings"><i class="fa-solid fa-sliders"></i> <%= t('admin.settings') %></button>
    <button type="button" data-tab="system"><i class="fa-solid fa-server"></i> <%= t('admin.system') %></button>
    <a href="/downloads"><i class="fa-solid fa-download"></i> <%= t('nav.downloads') %></a>
    <span class="sep"></span>
    <a href="/"><i class="fa-solid fa-arrow-left"></i> <%= t('admin.back_to_browse') %></a>
</aside>
<nav class="adm-mobilebar">
    <button type="button" data-tab="library"><%= t('admin.library') %></button>
    <button type="button" data-tab="users"><%= t('admin.users') %></button>
    <button type="button" data-tab="settings"><%= t('admin.settings') %></button>
    <button type="button" data-tab="system"><%= t('admin.system') %></button>
    <a href="/downloads"><%= t('nav.downloads') %></a>
    <a href="/"><%= t('admin.back_to_browse') %></a>
</nav>

<main class="adm-main" data-tab="<%= tab %>">
    <% if (!profile || !profile.pin) { %>
        <div class="nf-alert err adm-pin-nudge"><i class="fa-solid fa-lock-open"></i>
            <span><%= t('admin.pin_nudge') %> <a href="/profiles/<%= user.id %>/edit#nfLock" style="color:#fff;text-decoration:underline;font-weight:700"><%= t('admin.pin_nudge_action') %></a></span>
        </div>
    <% } %>
    <% if (flash) { %>
        <div class="nf-alert <%= ['taken', 'missing'].includes(flash) ? 'err' : 'ok' %> adm-flash"><i class="fa-solid fa-circle-info"></i> <%= t('admin.flash_' + flash) %></div>
    <% } %>

    <!-- LIBRARY -->
    <section class="adm-panel" id="tab-library">
        <div class="adm-top">
            <h1><%= t('admin.library') %> <small style="color:#8c8c8c;font-size:1rem;font-weight:400">(<%= titles.length %>)</small></h1>
            <div class="tools">
                <a class="nf-btn nf-btn-sm" href="/admin/title/new?type=series"><i class="fa-solid fa-tv"></i> <%= t('admin.add_series') %></a>
                <a class="nf-btn nf-btn-sm nf-btn-red" href="/admin/title/new?type=movie"><i class="fa-solid fa-plus"></i> <%= t('admin.add_movie') %></a>
            </div>
        </div>
        <% if (system.tmdbOn) { %>
        <div class="adm-card">
            <h2><i class="fa-solid fa-wand-magic-sparkles"></i> <%= t('admin.quick_add') %> <small><%= t('admin.quick_add_hint') %></small></h2>
            <div class="adm-search-row">
                <input class="adm-input" id="qaQuery" placeholder="<%= t('admin.tmdb_search_placeholder') %>">
                <select id="qaType"><option value=""><%= t('admin.any_type') %></option><option value="movie"><%= t('admin.movie') %></option><option value="series"><%= t('admin.series') %></option></select>
            </div>
            <div class="adm-tmdb" id="qaResults" data-mode="new"></div>
        </div>
        <% } %>
        <div class="adm-top" style="margin-bottom:1rem">
            <input class="adm-input" id="libFilter" placeholder="<%= t('admin.filter_titles') %>" style="max-width:340px">
            <div class="adm-filter" id="libType">
                <button type="button" data-type="" class="on"><%= t('downloads.filter_all') %></button>
                <button type="button" data-type="movie"><%= t('nav.movies') %></button>
                <button type="button" data-type="series"><%= t('nav.tv_shows') %></button>
            </div>
        </div>
        <% if (!titles.length) { %>
            <div class="adm-empty"><i class="fa-solid fa-film" style="font-size:2.4rem;display:block;margin-bottom:1rem"></i><%= t('admin.library_empty') %><div class="adm-actions" style="justify-content:center"><a href="/downloads" class="nf-btn nf-btn-red"><i class="fa-solid fa-magnet"></i> <%= t('home.add_torrent') %></a><a href="/admin/title/new" class="nf-btn"><i class="fa-solid fa-plus"></i> <%= t('admin.add_movie') %></a></div></div>
        <% } %>
        <div class="adm-lib" id="libGrid">
            <% titles.forEach(function (m) { %>
                <a class="adm-title" href="/admin/title/<%= m.id %>" data-type="<%= m.type %>" data-q="<%= (m.title + ' ' + (m.year || '') + ' ' + (m.category || '')).toLowerCase() %>">
                    <span class="img<%= m.landscape ? ' land' : '' %>">
                        <% if (m.img) { %><img src="<%= m.img %>" alt="" loading="lazy"><% } else { %><i class="fa-solid <%= m.type === 'series' ? 'fa-tv' : 'fa-film' %>"></i><% } %>
                        <span class="badges">
                            <% if (m.type === 'series') { %><span><%= t('admin.episodes_n', { n: m.episodes }) %></span><% } %>
                            <% if (m.trending) { %><span>★</span><% } %>
                            <% if (m.downloading) { %><span class="dl"><i class="fa-solid fa-magnet"></i></span><% } %>
                            <% if (!m.playable) { %><span class="warn" title="<%= t('admin.no_video') %>"><i class="fa-solid fa-triangle-exclamation"></i></span><% } %>
                        </span>
                    </span>
                    <b><%= m.title %></b>
                    <small><%= m.year || '' %><%= m.year && m.category ? ' · ' : '' %><%= m.category || '' %></small>
                </a>
            <% }) %>
        </div>
    </section>

    <!-- USERS -->
    <section class="adm-panel" id="tab-users">
        <div class="adm-top"><h1><%= t('admin.users') %></h1></div>
        <div class="adm-card">
            <h2 id="userFormTitle"><%= t('admin.create_new_user') %></h2>
            <form id="userForm" action="/admin/user/add" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="id" id="editUserId">
                <div class="adm-grid g4">
                    <div class="adm-field"><label><%= t('admin.username') %></label><input type="text" name="username" id="editUsername" required autocomplete="off"></div>
                    <div class="adm-field"><label><%= t('admin.password') %> <span id="passHint" style="text-transform:none"></span></label><input type="password" name="password" id="editPassword" placeholder="<%= t('admin.password_enter') %>" autocomplete="new-password" required></div>
                    <div class="adm-field"><label><%= t('admin.role') %></label><select name="role" id="editRole"><option value="viewer"><%= t('admin.viewer') %></option><option value="admin"><%= t('admin.admin_role') %></option></select></div>
                    <div class="adm-field"><label><%= t('admin.avatar') %></label><input type="file" name="avatar" accept="image/*" class="adm-input"></div>
                </div>
                <div class="adm-actions">
                    <button class="nf-btn nf-btn-red nf-btn-sm" id="userSubmitBtn" type="submit"><i class="fa-solid fa-plus"></i> <%= t('admin.create_user') %></button>
                    <button type="button" class="nf-btn nf-btn-sm" id="userCancelBtn" hidden><%= t('admin.cancel') %></button>
                </div>
            </form>
        </div>
        <div class="adm-card">
            <h2><%= t('admin.users_total') %> <small>(<%= users.length %>)</small></h2>
            <table class="adm-table">
                <thead><tr><th><%= t('admin.user') %></th><th><%= t('admin.role') %></th><th><%= t('admin.provider') %></th><th><%= t('admin.profiles_col') %></th><th></th></tr></thead>
                <tbody>
                <% users.forEach(function (u) { %>
                    <tr>
                        <td data-label=""><img class="av" src="<%= avatarUrl(u) %>" alt=""><%= u.username %><% if (user && u.id === user.id) { %> <small style="color:#8c8c8c">(<%= t('admin.you') %>)</small><% } %></td>
                        <td data-label="<%= t('admin.role') %>"><span class="adm-pill <%= u.role %>"><%= u.role === 'admin' ? t('admin.admin_role') : t('admin.viewer') %></span></td>
                        <td data-label="<%= t('admin.provider') %>"><%= u.auth_provider %></td>
                        <td data-label="<%= t('admin.profiles_col') %>"><%= u._count.profiles + 1 %></td>
                        <td style="text-align:right;white-space:nowrap">
                            <button class="adm-icon" type="button" data-edit-user="<%= JSON.stringify({ id: u.id, username: u.username, role: u.role }) %>" title="<%= t('admin.edit') %>"><i class="fa-solid fa-pen"></i></button>
                            <% if (!(user && u.id === user.id)) { %>
                                <form action="/admin/user/delete/<%= u.id %>" method="POST" style="display:inline" onsubmit="return confirm(<%= JSON.stringify(t('admin.delete_user_confirm')) %>)">
                                    <button class="adm-icon danger" title="<%= t('admin.delete') %>"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </section>

    <!-- SETTINGS -->
    <section class="adm-panel" id="tab-settings">
        <div class="adm-top"><h1><%= t('admin.settings') %></h1></div>
        <form action="/admin/settings/update" method="POST" class="adm-card">
            <h2><i class="fa-solid fa-palette"></i> <%= t('admin.branding') %></h2>
            <div class="adm-grid g3">
                <div class="adm-field"><label><%= t('admin.app_name') %></label><input type="text" name="APP_NAME" value="<%= config.APP_NAME || 'MEDIATER' %>" maxlength="30"></div>
                <div class="adm-field"><label><%= t('admin.accent_color') %></label><input type="color" name="ACCENT_COLOR" value="<%= config.ACCENT_COLOR || '#E50914' %>"></div>
                <div class="adm-field"><label><%= t('admin.language') %></label>
                    <select name="LANGUAGE"><% Object.entries(langLabels).forEach(function (e) { %><option value="<%= e[0] %>" <%= (config.LANGUAGE || 'en') === e[0] ? 'selected' : '' %>><%= e[1] %></option><% }) %></select>
                </div>
            </div>
            <div class="adm-actions"><button class="nf-btn nf-btn-red nf-btn-sm" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= t('admin.save_apply') %></button></div>
        </form>

        <form action="/admin/settings/update" method="POST" class="adm-card">
            <h2><i class="fa-solid fa-wand-magic-sparkles"></i> <%= t('admin.metadata') %></h2>
            <p class="hint"><%- t('admin.tmdb_hint', { link: '<a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener">themoviedb.org</a>' }) %></p>
            <div class="adm-grid g2">
                <div class="adm-field"><label><%= t('admin.tmdb_key') %> <% if (config.TMDB_API_KEY) { %><span class="adm-pill ok"><%= t('admin.configured') %></span><% } %></label><input type="password" name="TMDB_API_KEY" placeholder="<%= config.TMDB_API_KEY ? '••••••••••••' : t('admin.tmdb_key_placeholder') %>" autocomplete="off"></div>
                <div class="adm-field"><label><%= t('admin.tmdb_region') %></label><input type="text" name="TMDB_REGION" value="<%= config.TMDB_REGION || 'US' %>" maxlength="2" style="text-transform:uppercase"></div>
            </div>
            <% if (config.TMDB_API_KEY) { %><label class="adm-check" style="margin-top:.8rem"><input type="checkbox" name="TMDB_API_KEY_CLEAR"> <%= t('admin.remove_key') %></label><% } %>
            <div class="adm-actions"><button class="nf-btn nf-btn-red nf-btn-sm" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= t('admin.save_apply') %></button></div>
        </form>

        <form action="/admin/settings/update" method="POST" class="adm-card">
            <h2><i class="fa-solid fa-magnet"></i> <%= t('admin.torrents') %></h2>
            <div class="adm-grid g2">
                <div class="adm-field"><label><%= t('admin.down_limit') %></label><input type="number" min="0" name="TORRENT_DOWNLOAD_LIMIT" value="<%= config.TORRENT_DOWNLOAD_LIMIT || 0 %>"></div>
                <div class="adm-field"><label><%= t('admin.max_conns') %></label><input type="number" min="10" max="500" name="TORRENT_MAX_CONNS" value="<%= config.TORRENT_MAX_CONNS || 55 %>"></div>
            </div>
            <p class="adm-hint" style="margin-top:.8rem"><i class="fa-solid fa-shield-halved"></i> <%= t('admin.download_only_hint') %></p>
            <p class="adm-hint"><%= t('admin.torrents_hint') %></p>
            <div class="adm-actions"><button class="nf-btn nf-btn-red nf-btn-sm" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= t('admin.save_apply') %></button></div>
        </form>

        <form action="/admin/settings/update" method="POST" class="adm-card" id="search-sources">
            <input type="hidden" name="_form" value="search">
            <h2><i class="fa-solid fa-magnifying-glass"></i> <%= t('admin.search_title') %></h2>
            <label class="adm-check"><input type="checkbox" name="SEARCH_ARCHIVE" value="true" <%= config.SEARCH_ARCHIVE !== 'false' ? 'checked' : '' %>> <span><%= t('admin.search_archive') %></span></label>
            <div class="adm-grid g2" style="margin-top:1rem">
                <div class="adm-field"><label><%= t('admin.search_torznab') %></label>
                    <textarea name="TORZNAB_URLS" rows="3" spellcheck="false" placeholder="http://localhost:9117/api/v2.0/indexers/all/results/torznab/&#10;http://localhost:9696/1/api"><%= config.TORZNAB_URLS || '' %></textarea></div>
                <div class="adm-field"><label><%= t('admin.search_apikey') %> <% if (config.TORZNAB_API_KEY) { %><span class="adm-pill ok"><%= t('admin.configured') %></span><% } %></label>
                    <input type="password" name="TORZNAB_API_KEY" placeholder="<%= config.TORZNAB_API_KEY ? '••••••••••••' : '' %>" autocomplete="off"></div>
            </div>
            <% if (config.TORZNAB_API_KEY) { %><label class="adm-check" style="margin-top:.6rem"><input type="checkbox" name="TORZNAB_API_KEY_CLEAR"> <%= t('admin.remove_key') %></label><% } %>
            <p class="adm-hint" style="margin-top:.8rem"><%= t('admin.search_hint') %></p>
            <div class="adm-actions"><button class="nf-btn nf-btn-red nf-btn-sm" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= t('admin.save_apply') %></button></div>
        </form>

        <form action="/admin/settings/update" method="POST" class="adm-card">
            <input type="hidden" name="_form" value="playback">
            <h2><i class="fa-solid fa-circle-play"></i> <%= t('admin.playback') %></h2>
            <div class="adm-grid g2">
                <div class="adm-field"><label><%= t('admin.max_height') %></label>
                    <select name="TRANSCODE_MAX_HEIGHT"><% [720, 1080, 1440, 2160].forEach(function (h) { %><option value="<%= h %>" <%= String(config.TRANSCODE_MAX_HEIGHT || 1080) === String(h) ? 'selected' : '' %>><%= h %>p</option><% }) %></select>
                </div>
                <div class="adm-field" style="display:flex;align-items:flex-end"><label class="adm-check"><input type="checkbox" name="TRICKPLAY" value="true" <%= config.TRICKPLAY === 'false' ? '' : 'checked' %>> <%= t('admin.trickplay') %></label></div>
            </div>
            <div class="adm-actions"><button class="nf-btn nf-btn-red nf-btn-sm" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= t('admin.save_apply') %></button></div>
        </form>

        <form action="/admin/settings/update" method="POST" class="adm-card">
            <h2><i class="fa-solid fa-shield-halved"></i> <%= t('admin.sso_title') %></h2>
            <div class="adm-grid g2">
                <div class="adm-field"><label><%= t('admin.public_url') %></label><input type="text" name="PUBLIC_URL" value="<%= config.PUBLIC_URL || '' %>" placeholder="https://media.example.com"></div>
                <div class="adm-field"><label><%= t('admin.issuer_url') %></label><input type="text" name="OIDC_ISSUER" value="<%= config.OIDC_ISSUER || '' %>"></div>
                <div class="adm-field"><label><%= t('admin.client_id') %></label><input type="text" name="OIDC_CLIENT_ID" value="<%= config.OIDC_CLIENT_ID || '' %>"></div>
                <div class="adm-field"><label><%= t('admin.client_secret') %></label><input type="password" name="OIDC_CLIENT_SECRET" placeholder="<%= config.OIDC_CLIENT_SECRET ? '••••••••••••' : '' %>" autocomplete="off"></div>
                <div class="adm-field"><label><%= t('admin.auth_url') %></label><input type="text" name="OIDC_AUTH_URL" value="<%= config.OIDC_AUTH_URL || '' %>"></div>
                <div class="adm-field"><label><%= t('admin.token_url') %></label><input type="text" name="OIDC_TOKEN_URL" value="<%= config.OIDC_TOKEN_URL || '' %>"></div>
                <div class="adm-field"><label><%= t('admin.userinfo_url') %></label><input type="text" name="OIDC_USERINFO_URL" value="<%= config.OIDC_USERINFO_URL || '' %>"></div>
            </div>
            <div class="adm-actions"><button class="nf-btn nf-btn-red nf-btn-sm" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= t('admin.save_apply') %></button></div>
        </form>
    </section>

    <!-- SYSTEM -->
    <section class="adm-panel" id="tab-system">
        <div class="adm-top"><h1><%= t('admin.system') %></h1>
            <form method="POST" action="/admin/system/rescan"><button class="nf-btn nf-btn-sm" type="submit"><i class="fa-solid fa-arrows-rotate"></i> <%= t('admin.rescan') %></button></form>
        </div>
        <div class="adm-stats">
            <div class="adm-stat"><div class="k">ffmpeg</div><div class="v"><% if (system.ffmpeg) { %><i class="fa-solid fa-circle-check ok"></i> <%= system.ffmpeg.version.split('-')[0] %><% } else { %><i class="fa-solid fa-triangle-exclamation bad"></i> <%= t('admin.not_found') %><% } %></div><p><%= system.ffmpeg ? t('admin.ffmpeg_ok') : t('admin.ffmpeg_missing') %></p></div>
            <div class="adm-stat"><div class="k">ffprobe</div><div class="v"><% if (system.ffprobe) { %><i class="fa-solid fa-circle-check ok"></i> <%= system.ffprobe.version.split('-')[0] %><% } else { %><i class="fa-solid fa-triangle-exclamation bad"></i> <%= t('admin.not_found') %><% } %></div></div>
            <div class="adm-stat"><div class="k"><%= t('admin.torrent_engine') %></div><div class="v"><% if (system.torrents.enabled) { %><i class="fa-solid fa-circle-check ok"></i> <%= t('admin.running') %><% } else { %><i class="fa-solid fa-circle-xmark bad"></i> <%= t('admin.off') %><% } %></div><p><%= t('admin.torrent_stats', { active: system.torrents.active, total: system.torrents.total }) %><% if (system.torrents.reason) { %> — <%= system.torrents.reason %><% } %></p></div>
            <div class="adm-stat"><div class="k"><%= t('admin.storage') %></div><div class="v"><%= fmtB(system.disk.free) %> <small style="font-weight:400;color:#8c8c8c"><%= t('admin.free_of', { total: fmtB(system.disk.total) }) %></small></div><p><%= system.dirs.downloads %></p></div>
            <div class="adm-stat"><div class="k"><%= t('admin.metadata') %></div><div class="v"><% if (system.tmdbOn) { %><i class="fa-solid fa-circle-check ok"></i> TMDB<% } else { %><i class="fa-solid fa-circle-minus bad"></i> <%= t('admin.off') %><% } %></div></div>
            <div class="adm-stat"><div class="k"><%= t('admin.background_jobs') %></div><div class="v"><%= system.jobs.queued.length + (system.jobs.running ? 1 : 0) %></div><p><%= system.jobs.running || t('admin.idle') %></p></div>
            <div class="adm-stat"><div class="k"><%= t('admin.live_conversions') %></div><div class="v"><%= system.transcodes %></div></div>
            <div class="adm-stat"><div class="k">Node.js</div><div class="v"><%= system.node %></div><p><%= t('admin.subtitles_count', { n: system.subCount }) %></p></div>
        </div>
        <div class="adm-card" style="margin-top:1.4rem">
            <h2><i class="fa-regular fa-folder-open"></i> <%= t('admin.folders') %></h2>
            <table class="adm-table"><tbody>
                <% Object.entries(system.dirs).forEach(function (e) { %><tr><td data-label=""><%= e[0] %></td><td><code><%= e[1] %></code></td></tr><% }) %>
            </tbody></table>
        </div>
    </section>
</main>
<%- include('partials/overlays') %>
<script>window.__adm = <%- jsonScript({ i18n: dict.admin || {} }) %>;</script>
<%- include('partials/scripts') %>
<script src="/js/admin.js?v=<%= assetVersion %>"></script>
</body>
</html>
